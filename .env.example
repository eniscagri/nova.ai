# Backend: only server reads these values. PI variables are intentionally unused until
# Pi publishes an official public chatbot API with endpoint and authentication docs.
PORT=3001
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
CORS_ORIGIN=http://localhost:5173,https://localhost
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_MESSAGE_LENGTH=12000
MAX_CONVERSATION_MESSAGES=60
# Pi.ai variables are intentionally omitted: no public Pi chatbot API was verified.

# Client: public production backend URL (never put secrets under VITE_).
VITE_API_URL=http://10.0.2.2:3001
